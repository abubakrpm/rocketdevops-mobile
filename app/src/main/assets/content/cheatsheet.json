[
  {"id": "cheat-pwd", "category": "linux", "command": "pwd", "description": "Show the folder you are in", "example": "pwd"},
  {"id": "cheat-ls", "category": "linux", "command": "ls", "description": "List files in a folder", "example": "ls -la /var/log", "commonFlags": [{"flag": "-l", "meaning": "long listing with permissions and sizes"}, {"flag": "-a", "meaning": "include hidden files"}, {"flag": "-h", "meaning": "human-readable sizes (with -l)"}]},
  {"id": "cheat-cd", "category": "linux", "command": "cd", "description": "Change the current folder", "example": "cd ~/projects", "commonFlags": [{"flag": "..", "meaning": "go up one folder"}, {"flag": "~", "meaning": "go to your home folder"}]},
  {"id": "cheat-mkdir", "category": "linux", "command": "mkdir", "description": "Create a folder", "example": "mkdir -p app/src", "commonFlags": [{"flag": "-p", "meaning": "create missing parent folders too"}]},
  {"id": "cheat-cp", "category": "linux", "command": "cp", "description": "Copy files or folders", "example": "cp -r config config.bak", "commonFlags": [{"flag": "-r", "meaning": "copy folders and everything inside"}]},
  {"id": "cheat-grep", "category": "linux", "command": "grep", "description": "Find lines that match text", "example": "grep -i error app.log", "commonFlags": [{"flag": "-i", "meaning": "ignore upper and lower case"}, {"flag": "-r", "meaning": "search inside folders"}, {"flag": "-n", "meaning": "show line numbers"}]},
  {"id": "cheat-chmod", "category": "linux", "command": "chmod", "description": "Change file permissions", "example": "chmod 755 deploy.sh", "commonFlags": [{"flag": "+x", "meaning": "add execute permission"}, {"flag": "-R", "meaning": "apply to a folder and its contents"}]},
  {"id": "cheat-cat", "category": "linux", "command": "cat", "description": "Print a file", "example": "cat notes.txt"},
  {"id": "cheat-touch", "category": "linux", "command": "touch", "description": "Create an empty file", "example": "touch app.log"},
  {"id": "cheat-rm", "category": "linux", "command": "rm", "description": "Delete files (no recycle bin)", "example": "rm -r old-build", "commonFlags": [{"flag": "-r", "meaning": "delete a folder and everything in it"}, {"flag": "-f", "meaning": "never ask, ignore missing files"}, {"flag": "-i", "meaning": "ask before each file"}]},
  {"id": "cheat-mv", "category": "linux", "command": "mv", "description": "Move or rename", "example": "mv draft.txt final.txt"},
  {"id": "cheat-echo", "category": "linux", "command": "echo", "description": "Print text or write it to a file", "example": "echo \"PORT=3000\" >> .env", "commonFlags": [{"flag": ">", "meaning": "write to a file, replacing it"}, {"flag": ">>", "meaning": "add to the end of a file"}]},
  {"id": "cheat-head", "category": "linux", "command": "head", "description": "Show the first lines of a file", "example": "head -n 5 app.log", "commonFlags": [{"flag": "-n", "meaning": "how many lines (default 10)"}]},
  {"id": "cheat-tail", "category": "linux", "command": "tail", "description": "Show the last lines of a file", "example": "tail -n 20 app.log", "commonFlags": [{"flag": "-n", "meaning": "how many lines (default 10)"}, {"flag": "-f", "meaning": "keep showing new lines as they arrive"}]},
  {"id": "cheat-wc", "category": "linux", "command": "wc", "description": "Count lines, words and bytes", "example": "wc -l app.log", "commonFlags": [{"flag": "-l", "meaning": "lines only"}, {"flag": "-w", "meaning": "words only"}]},
  {"id": "cheat-pipe", "category": "linux", "command": "|", "description": "Send one command's output into another", "example": "cat app.log | grep ERROR | wc -l"},
  {"id": "cheat-find", "category": "linux", "command": "find", "description": "Search for files by name", "example": "find . -name \"*.log\"", "commonFlags": [{"flag": "-name", "meaning": "match a file name pattern"}, {"flag": "-type f", "meaning": "files only (d for folders)"}]},
  {"id": "cheat-less", "category": "linux", "command": "less", "description": "Read a long file page by page", "example": "less /var/log/syslog", "commonFlags": [{"flag": "/word", "meaning": "search forward"}, {"flag": "q", "meaning": "quit"}]},
  {"id": "cheat-chown", "category": "linux", "command": "chown", "description": "Change who owns a file", "example": "sudo chown www-data:www-data site/", "commonFlags": [{"flag": "-R", "meaning": "include everything inside a folder"}]},
  {"id": "cheat-ps", "category": "linux", "command": "ps", "description": "List running processes", "example": "ps aux", "commonFlags": [{"flag": "aux", "meaning": "every process, with CPU and memory"}]},
  {"id": "cheat-kill", "category": "linux", "command": "kill", "description": "Stop a process by its PID", "example": "kill -9 2210", "commonFlags": [{"flag": "-9", "meaning": "force stop (KILL), cannot be ignored"}, {"flag": "-15", "meaning": "polite stop (TERM), the default"}]},
  {"id": "cheat-pgrep", "category": "linux", "command": "pgrep", "description": "Find the PID of a program by name", "example": "pgrep nginx"},
  {"id": "cheat-top", "category": "linux", "command": "top", "description": "Live view of the busiest processes", "example": "top", "commonFlags": [{"flag": "q", "meaning": "quit"}, {"flag": "P", "meaning": "sort by CPU"}]},
  {"id": "cheat-df", "category": "linux", "command": "df", "description": "Free space on each disk", "example": "df -h", "commonFlags": [{"flag": "-h", "meaning": "human-readable sizes"}]},
  {"id": "cheat-du", "category": "linux", "command": "du", "description": "How much space a folder uses", "example": "du -sh logs/", "commonFlags": [{"flag": "-s", "meaning": "one total"}, {"flag": "-h", "meaning": "human-readable sizes"}]},
  {"id": "cheat-free", "category": "linux", "command": "free", "description": "Memory in use and free", "example": "free -h", "commonFlags": [{"flag": "-h", "meaning": "human-readable sizes"}]},
  {"id": "cheat-tar", "category": "linux", "command": "tar", "description": "Pack or unpack an archive", "example": "tar -czf backup.tar.gz site/", "commonFlags": [{"flag": "-c", "meaning": "create"}, {"flag": "-x", "meaning": "extract"}, {"flag": "-z", "meaning": "gzip compression"}, {"flag": "-f", "meaning": "archive file name"}]},
  {"id": "cheat-curl", "category": "linux", "command": "curl", "description": "Make a web request", "example": "curl -I http://localhost:8080", "commonFlags": [{"flag": "-I", "meaning": "headers only"}, {"flag": "-o", "meaning": "save to a file"}]},
  {"id": "cheat-ssh", "category": "linux", "command": "ssh", "description": "Log in to another machine", "example": "ssh deploy@203.0.113.10", "commonFlags": [{"flag": "-i", "meaning": "use this private key"}, {"flag": "-p", "meaning": "port (default 22)"}]},
  {"id": "cheat-scp", "category": "linux", "command": "scp", "description": "Copy files to or from another machine", "example": "scp app.tar.gz deploy@203.0.113.10:/tmp/", "commonFlags": [{"flag": "-r", "meaning": "copy a whole folder"}]},
  {"id": "cheat-sudo", "category": "linux", "command": "sudo", "description": "Run one command as root", "example": "sudo systemctl restart nginx"},
  {"id": "cheat-history", "category": "linux", "command": "history", "description": "Commands you typed before", "example": "history | grep docker"},
  {"id": "cheat-export", "category": "linux", "command": "export", "description": "Set an environment variable", "example": "export NODE_ENV=production"},
  {"id": "cheat-bash-script", "category": "linux", "command": "bash", "description": "Run a shell script", "example": "bash deploy.sh"},
  {"id": "cheat-git-status", "category": "git", "command": "git status", "description": "Show changed and staged files", "example": "git status"},
  {"id": "cheat-git-add", "category": "git", "command": "git add", "description": "Stage changes for the next commit", "example": "git add .", "commonFlags": [{"flag": ".", "meaning": "stage everything in this folder"}, {"flag": "-p", "meaning": "choose changes piece by piece"}]},
  {"id": "cheat-git-commit", "category": "git", "command": "git commit", "description": "Save staged changes as a snapshot", "example": "git commit -m \"Fix login bug\"", "commonFlags": [{"flag": "-m", "meaning": "write the message inline"}]},
  {"id": "cheat-git-log", "category": "git", "command": "git log", "description": "Show commit history", "example": "git log --oneline", "commonFlags": [{"flag": "--oneline", "meaning": "one short line per commit"}, {"flag": "--graph", "meaning": "draw branches as a graph"}]},
  {"id": "cheat-git-switch", "category": "git", "command": "git switch", "description": "Move to another branch", "example": "git switch -c feature/login", "commonFlags": [{"flag": "-c", "meaning": "create the branch first"}]},
  {"id": "cheat-git-merge", "category": "git", "command": "git merge", "description": "Bring another branch into the current one", "example": "git merge feature/login"},
  {"id": "cheat-git-init", "category": "git", "command": "git init", "description": "Start a repository in this folder", "example": "git init"},
  {"id": "cheat-git-clone", "category": "git", "command": "git clone", "description": "Download a repository", "example": "git clone https://github.com/user/app.git"},
  {"id": "cheat-git-diff", "category": "git", "command": "git diff", "description": "Show changes not staged yet", "example": "git diff", "commonFlags": [{"flag": "--staged", "meaning": "show staged changes instead"}]},
  {"id": "cheat-git-branch", "category": "git", "command": "git branch", "description": "List, create or delete branches", "example": "git branch -d old-feature", "commonFlags": [{"flag": "-d", "meaning": "delete a merged branch"}, {"flag": "-a", "meaning": "include remote branches"}]},
  {"id": "cheat-git-checkout", "category": "git", "command": "git checkout", "description": "Switch branch (older command)", "example": "git checkout -b fix-login", "commonFlags": [{"flag": "-b", "meaning": "create the branch first"}]},
  {"id": "cheat-git-restore", "category": "git", "command": "git restore", "description": "Undo changes to a file", "example": "git restore index.html", "commonFlags": [{"flag": "--staged", "meaning": "unstage, keep the changes"}]},
  {"id": "cheat-git-reset", "category": "git", "command": "git reset", "description": "Move the branch back to an earlier commit", "example": "git reset --soft HEAD~1", "commonFlags": [{"flag": "--soft", "meaning": "keep the changes staged"}, {"flag": "--hard", "meaning": "throw the changes away"}]},
  {"id": "cheat-git-revert", "category": "git", "command": "git revert", "description": "Undo a commit with a new commit", "example": "git revert 3f2a91b"},
  {"id": "cheat-git-stash", "category": "git", "command": "git stash", "description": "Put unfinished work aside", "example": "git stash pop", "commonFlags": [{"flag": "pop", "meaning": "bring the work back"}, {"flag": "list", "meaning": "show saved stashes"}]},
  {"id": "cheat-git-pull", "category": "git", "command": "git pull", "description": "Get and merge new commits from the remote", "example": "git pull origin main"},
  {"id": "cheat-git-push", "category": "git", "command": "git push", "description": "Send your commits to the remote", "example": "git push -u origin main", "commonFlags": [{"flag": "-u", "meaning": "remember this remote branch"}]},
  {"id": "cheat-git-fetch", "category": "git", "command": "git fetch", "description": "Download remote commits without merging", "example": "git fetch origin"},
  {"id": "cheat-git-remote", "category": "git", "command": "git remote", "description": "List or add remotes", "example": "git remote -v", "commonFlags": [{"flag": "-v", "meaning": "show the URLs"}, {"flag": "add", "meaning": "add a remote"}]},
  {"id": "cheat-git-config", "category": "git", "command": "git config", "description": "Set your name and email", "example": "git config --global user.name \"Ada\""},
  {"id": "cheat-git-merge-abort", "category": "git", "command": "git merge --abort", "description": "Cancel a merge that has conflicts", "example": "git merge --abort"},
  {"id": "cheat-git-log-graph", "category": "git", "command": "git log --graph", "description": "History drawn as a branch graph", "example": "git log --oneline --graph --all"},
  {"id": "cheat-git-show", "category": "git", "command": "git show", "description": "One commit's details and changes", "example": "git show 3f2a91b"},
  {"id": "cheat-git-tag", "category": "git", "command": "git tag", "description": "Mark a release", "example": "git tag v1.0.0"},
  {"id": "cheat-docker-pull", "category": "docker", "command": "docker pull", "description": "Download an image", "example": "docker pull nginx:1.27"},
  {"id": "cheat-docker-run", "category": "docker", "command": "docker run", "description": "Start a container from an image", "example": "docker run -d --name web -p 8080:80 nginx", "commonFlags": [{"flag": "-d", "meaning": "run in the background"}, {"flag": "-p", "meaning": "publish a port, host:container"}, {"flag": "--name", "meaning": "give the container a name"}, {"flag": "--rm", "meaning": "remove the container when it stops"}]},
  {"id": "cheat-docker-ps", "category": "docker", "command": "docker ps", "description": "List running containers", "example": "docker ps -a", "commonFlags": [{"flag": "-a", "meaning": "include stopped containers"}]},
  {"id": "cheat-docker-logs", "category": "docker", "command": "docker logs", "description": "Show a container's output", "example": "docker logs -f web", "commonFlags": [{"flag": "-f", "meaning": "keep following new lines"}]},
  {"id": "cheat-docker-exec", "category": "docker", "command": "docker exec", "description": "Run a command inside a container", "example": "docker exec -it web sh", "commonFlags": [{"flag": "-it", "meaning": "interactive terminal"}]},
  {"id": "cheat-docker-images", "category": "docker", "command": "docker images", "description": "List images on this machine", "example": "docker images"},
  {"id": "cheat-docker-build", "category": "docker", "command": "docker build", "description": "Build an image from a Dockerfile", "example": "docker build -t mysite .", "commonFlags": [{"flag": "-t", "meaning": "name (tag) the image"}, {"flag": ".", "meaning": "use the Dockerfile in this folder"}]},
  {"id": "cheat-docker-stop", "category": "docker", "command": "docker stop", "description": "Stop a running container", "example": "docker stop web"},
  {"id": "cheat-docker-start", "category": "docker", "command": "docker start", "description": "Start a stopped container again", "example": "docker start web"},
  {"id": "cheat-docker-rm", "category": "docker", "command": "docker rm", "description": "Delete a container", "example": "docker rm -f web", "commonFlags": [{"flag": "-f", "meaning": "stop it first if running"}]},
  {"id": "cheat-docker-rmi", "category": "docker", "command": "docker rmi", "description": "Delete an image", "example": "docker rmi nginx"},
  {"id": "cheat-docker-inspect", "category": "docker", "command": "docker inspect", "description": "Every detail of a container as JSON", "example": "docker inspect web"},
  {"id": "cheat-docker-port-map", "category": "docker", "command": "docker run -p", "description": "Publish a container port", "example": "docker run -d -p 8080:80 nginx", "commonFlags": [{"flag": "8080:80", "meaning": "host port : container port"}]},
  {"id": "cheat-docker-volume-run", "category": "docker", "command": "docker run -v", "description": "Keep data in a volume", "example": "docker run -d -v pgdata:/var/lib/postgresql/data postgres"},
  {"id": "cheat-docker-volume-ls", "category": "docker", "command": "docker volume ls", "description": "List volumes", "example": "docker volume ls"},
  {"id": "cheat-docker-network-ls", "category": "docker", "command": "docker network ls", "description": "List networks", "example": "docker network ls"},
  {"id": "cheat-docker-compose-up", "category": "docker", "command": "docker compose up", "description": "Start every service in compose.yaml", "example": "docker compose up -d", "commonFlags": [{"flag": "-d", "meaning": "run in the background"}, {"flag": "--build", "meaning": "rebuild images first"}]},
  {"id": "cheat-docker-compose-down", "category": "docker", "command": "docker compose down", "description": "Stop and remove the compose services", "example": "docker compose down"},
  {"id": "cheat-docker-cp", "category": "docker", "command": "docker cp", "description": "Copy files in or out of a container", "example": "docker cp web:/etc/nginx/nginx.conf ."},
  {"id": "cheat-docker-tag", "category": "docker", "command": "docker tag", "description": "Give an image another name", "example": "docker tag mysite user/mysite:1.0"},
  {"id": "cheat-docker-push", "category": "docker", "command": "docker push", "description": "Upload an image to a registry", "example": "docker push user/mysite:1.0"},
  {"id": "cheat-docker-prune", "category": "docker", "command": "docker system prune", "description": "Remove unused containers and images", "example": "docker system prune", "commonFlags": [{"flag": "-a", "meaning": "also unused images, not only dangling ones"}]}
]
